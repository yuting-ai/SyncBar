      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download FreeFileSync"
          }
        }
      }
    },
    "什么时候同步": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When to Sync"
          }
        }
      }
    },
    "仅手动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manually"
          }
        }
      }
    },
    "仅手动同步": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
