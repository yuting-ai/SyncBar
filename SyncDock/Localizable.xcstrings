    "把新增和修改过的文件复制到目标，不删除目标里的任何文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies new and changed files to the destination. Nothing in the destination is ever deleted."
          }
        }
      }
    },
