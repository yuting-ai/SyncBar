      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and Sync"
          }
        }
      }
    },
    "允许 FreeFileSync 访问所有文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow FreeFileSync to access all files"
