  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@  →  %@": {
      "shouldTranslate": false
    },
    "%@ 未连接，到时会跳过": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ not connected, will be skipped"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld 个任务需要注意": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld task needs attention"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld tasks need attention"
                }
              }
            }
          }
        }
      }
    },
    "%lld 个任务，全部正常": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld task, all good"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld tasks, all good"
                }
              }
            }
