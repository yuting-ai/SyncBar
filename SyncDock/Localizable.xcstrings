      }
    },
    "安装 FreeFileSync": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install FreeFileSync"
          }
        }
      }
    },
    "定时同步在后台运行，没人能点「允许」，所以要提前授权，FreeFileSync 才能读取桌面、文稿和移动硬盘。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled syncs run in the background where nobody can click “Allow”, so FreeFileSync needs permission in advance to read your Desktop, Documents and external drives."
          }
        }
      }
    },
    "已 %lld 天未同步": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Not synced for %lld day"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Not synced for %lld days"
                }
              }
            }
          }
