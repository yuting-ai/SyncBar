    "今天 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today %@"
          }
        }
      }
    },
    "任务名称不能包含 / : \\": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name can’t contain / : \\"
          }
        }
      }
    },
    "但保留 .git 文件夹（Git 仓库的历史记录）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "But keep .git folders (Git repository history)"
          }
        }
      }
    },
    "例如：论文-移动硬盘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. Thesis to SSD"
